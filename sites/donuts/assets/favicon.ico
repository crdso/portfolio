  <div class="intro" aria-hidden="true">
    <div class="intro__logo">
      <img src="assets/img/logo.webp" width="485" height="318" alt="">
      <span class="intro__tag">Londrina</span>
    </div>
  </div>

  <header class="header header--auto">
    <div class="container header__inner">
      <a href="#inicio" class="brand" aria-label="Hello Donuts Londrina, início">
        <img src="assets/img/logo.webp" width="485" height="318" alt="Hello Donuts">
        <span class="brand__unit">Unidade<br>Londrina</span>
      </a>

      <nav class="nav" id="nav" aria-label="Principal">
        <a href="#inicio" class="nav__link is-active">Início</a>
        <a href="cardapio.html" class="nav__link">Cardápio</a>
        <a href="#combo" class="nav__link">Combo</a>
        <a href="#loja" class="nav__link">A loja</a>
        <a href="#contato" class="nav__link">Contato</a>
      </nav>

      <div class="header__actions">
        <button class="order-btn" type="button" data-cart-open aria-haspopup="dialog">
          <svg class="i " aria-hidden="true"><use href="#i-cart"/></svg>
          <span class="order-btn__txt">Carrinho</span>
          <span class="order-btn__n" hidden>0</span>
        </button>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav"><span></span><span></span></button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" id="inicio">
      <picture>
        <source media="(max-aspect-ratio: 5/4), (max-width: 760px)" srcset="assets/img/hero-cena-celular.webp" width="768" height="1150">
        <source srcset="assets/img/hero-cena-1600.webp 1600w, assets/img/hero-cena.webp 2400w" sizes="100vw">
        <img class="hero__bg" src="assets/img/hero-cena-1600.webp" width="2400" height="1350" alt="" fetchpriority="high" decoding="async">
      </picture>
      <!-- o donut é uma camada do mesmo tamanho da cena: flutua sem sair do lugar em nenhuma tela -->
      <picture>
        <source media="(max-aspect-ratio: 5/4), (max-width: 760px)" srcset="assets/img/hero-donut-celular.webp" width="768" height="1150">
        <source srcset="assets/img/hero-donut-1600.webp 1600w, assets/img/hero-donut.webp 2400w" sizes="100vw">
        <img class="hero__bg hero__donut" src="assets/img/hero-donut-1600.webp" width="2400" height="1350" alt="" decoding="async">
      </picture>

      <div class="hero__content">
        <h1 class="hero__brand">
          <img class="hero__logo" src="assets/img/logo.webp" width="485" height="318" alt="Hello Donuts &amp; Coffee">
          <span class="hero__tag">Unidade Londrina</span>
        </h1>

        <p class="hero__slogan">
          <span>Life is better</span>
          <em>with donuts!</em>
          <svg class="hero__underline" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><path d="M1 5C30 2 70 1 99 1.600"/></svg>
        </p>

        <ul class="hero__features">
          <li><svg class="i " aria-hidden="true"><use href="#i-donut"/></svg><span>Donuts<br>fresquinhos</span></li>
          <li><svg class="i " aria-hidden="true"><use href="#i-star"/></svg><span>Ingredientes<br>selecionados</span></li>
          <li><svg class="i " aria-hidden="true"><use href="#i-camera"/></svg><span>Ambiente<br>instagramável</span></li>
        </ul>

        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="cardapio.html">Ver cardápio <svg class="i i-arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn--outline-berry btn--lg" href="#combo">Combo R$ 49,90</a>
        </div>
      </div>

      <a class="hero__scroll" href="#donuts" aria-label="Rolar para os donuts"><svg class="i " aria-hidden="true"><use href="#i-down"/></svg></a>
    </section>

    <section class="show show--pink" id="donuts">
      <div class="show__sprinkles" aria-hidden="true"></div>
      <div class="container">
        <div class="show__head reveal">
          <span class="kicker">Nossos donuts</span>
          <h2 class="title">Os queridinhos <em>da vitrine</em></h2>
          <p class="show__lead">Do tradicional sem recheio ao super premium: toque no + para montar o carrinho e finalize o pedido pelo WhatsApp.</p>
          <a class="btn btn--cream" href="cardapio.html">Ver cardápio completo <svg class="i i-arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
        <div class="show__stage show__stage--3">
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/churros.webp" width="657" height="471" alt="Donut de churros empanado no açúcar e canela, recheado com doce de leite" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><strong>Churros</strong><span class="price"><small>R$</small>22,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Donut%20Churros" target="_blank" rel="noopener" data-add="churros" aria-label="Adicionar Donut Churros ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/ferrero.webp" width="767" height="577" alt="Donut Ferrero Rocher mordido, mostrando o recheio cremoso de avelã" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><strong>Ferrero Rocher</strong><span class="price"><small>R$</small>29,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Donut%20Ferrero%20Rocher" target="_blank" rel="noopener" data-add="ferrero-rocher" aria-label="Adicionar Donut Ferrero Rocher ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/mms.webp" width="527" height="528" alt="Donut de chocolate coberto com M&amp;M's coloridos" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><strong>M&amp;M's</strong><span class="price"><small>R$</small>25,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Donut%20M%26M's" target="_blank" rel="noopener" data-add="m-m-s" aria-label="Adicionar Donut M&amp;M's ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="show show--light" id="shakes">
      <div class="show__sprinkles" aria-hidden="true"></div>
      <div class="container">
        <div class="show__head reveal">
          <span class="kicker">Milkshakes &amp; coffee</span>
          <h2 class="title">Pra acompanhar, <em>um shake</em></h2>
          <p class="show__lead">Milkshakes cremosos e o Iced Capuccino da casa para acompanhar o seu donut.</p>
          <a class="btn btn--primary" href="cardapio.html#shakes">Ver bebidas <svg class="i i-arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
        <div class="show__stage show__stage--drinks">
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/milk-homer.webp" width="255" height="714" alt="Milkshake Homer cor-de-rosa em taça alta, com chantilly e granulado colorido" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><small>Milkshake</small><strong>Homer</strong><span class="price"><small>R$</small>24,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Milkshake%20Homer" target="_blank" rel="noopener" data-add="milkshake-homer" aria-label="Adicionar Milkshake Homer ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/milk-morango.webp" width="433" height="615" alt="Milkshake de morango no copo da Hello Donuts, com chantilly e um morango" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><small>Milkshake</small><strong>Morango</strong><span class="price"><small>R$</small>24,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Milkshake%20Morango" target="_blank" rel="noopener" data-add="milkshake-morango" aria-label="Adicionar Milkshake Morango ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
          <figure class="show__item">
            <span class="show__img"><img src="assets/img/cut/milk-ovomaltine.webp" width="434" height="782" alt="Milkshake de Ovomaltine no copo da Hello Donuts" loading="lazy" decoding="async"></span>
            <figcaption class="show__tag">
              <span><small>Milkshake</small><strong>Ovomaltine</strong><span class="price"><small>R$</small>24,90</span></span>
              <a class="add-btn" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Milkshake%20Ovomaltine" target="_blank" rel="noopener" data-add="milkshake-ovomaltine" aria-label="Adicionar Milkshake Ovomaltine ao carrinho"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg><span class="add-n" aria-hidden="true"></span></a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="combo">
      <div class="container">
        <div class="combo reveal">
          <div class="combo__text">
            <span class="combo__brush"><span>Combo</span></span>
            <h2 class="combo__name">Felicidade</h2>
            <ul class="combo__list">
              <li><span class="check"><svg class="i " aria-hidden="true"><use href="#i-check"/></svg></span>1 Donut de Frango com Cream Cheese</li>
              <li><span class="check"><svg class="i " aria-hidden="true"><use href="#i-check"/></svg></span>1 Donut de Chocolate</li>
              <li><span class="check"><svg class="i " aria-hidden="true"><use href="#i-check"/></svg></span><span>1 Refrigerante de 220 ml<small>Coca-Cola, Coca Zero ou Guaraná Antarctica</small></span></li>
            </ul>
            <div class="combo__price">
              <div><small>APENAS</small><strong><span>R$</span>49,90</strong></div>
              <div><span class="combo__save"><s>R$ 51,80</s>economize R$ 1,90</span></div>
            </div>
            <div class="combo__cta">
              <a class="btn btn--cream btn--lg" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Combo%20Felicidade" target="_blank" rel="noopener" data-add="combo-felicidade" data-add-open>Quero o combo <svg class="i i-arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </div>
          </div>
          <div class="combo__visual">
            <img class="combo__photo" src="assets/img/combo-felicidade.webp" width="800" height="880" alt="Combo Felicidade: donut de chocolate, donut salgado de frango com cream cheese e uma Coca-Cola" loading="lazy" decoding="async">
            <ul class="combo__chips" aria-hidden="true"><li>Salgado</li><li>+</li><li>Doce</li><li>+</li><li>Refri</li></ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--blush" id="box">
      <div class="container">
        <div class="head reveal">
          <span class="kicker">Pra dividir (ou não)</span>
          <h2 class="title">Hello Box <em>com 12 donuts</em></h2>
          <p class="lead">Uma caixa com doze donuts médios para levar para casa, para o trabalho ou para presentear.</p>
        </div>
        <div class="boxes">
          <article class="box reveal" style="--d:0ms">
            <div class="box__media">
              <img src="assets/img/box-tradicional.webp" width="720" height="600" alt="Hello Box Tradicional aberta, com doze donuts" loading="lazy" decoding="async">
              <span class="box__badge">Sem recheio</span>
            </div>
            <div class="box__body">
              <h3 class="box__name">Hello Box Tradicional</h3>
              <p class="box__desc">12 donuts médios sem recheio: 4 empanados no açúcar e canela, 4 glazed, 2 americanos de chocolate preto e 2 de chocolate branco.</p>
              <div class="box__foot">
                <span class="price"><small>R$</small>49,90</span>
                <a class="btn btn--primary" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Hello%20Box%20Tradicional" target="_blank" rel="noopener" data-add="hello-box-tradicional"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg> Adicionar<span class="add-n" aria-hidden="true"></span></a>
              </div>
            </div>
          </article>
          <article class="box reveal" style="--d:90ms">
            <div class="box__media">
              <img src="assets/img/box-gourmet.webp" width="720" height="600" alt="Hello Box Gourmet aberta, com doze donuts" loading="lazy" decoding="async">
              <span class="box__badge">Recheados</span>
            </div>
            <div class="box__body">
              <h3 class="box__name">Hello Box Gourmet</h3>
              <p class="box__desc">12 donuts médios recheados: 2 de morango branco, 2 Homer, 2 de chocolate, 2 de churros, 2 de 4 leites e 2 red velvet.</p>
              <div class="box__foot">
                <span class="price"><small>R$</small>69,90</span>
                <a class="btn btn--primary" href="https://wa.me/5543991252053?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Hello%20Donuts%20Londrina%20e%20quero%20pedir%3A%20Hello%20Box%20Gourmet" target="_blank" rel="noopener" data-add="hello-box-gourmet"><svg class="i " aria-hidden="true"><use href="#i-plus"/></svg> Adicionar<span class="add-n" aria-hidden="true"></span></a>
              </div>
            </div>
          </article>
          <article class="box reveal" style="--d:180ms">
            <div class="box__media">
              <img src="assets/img/box-premium.webp" width="720" height="600" alt="Hello Box Premium aberta, com doze donuts" loading="lazy" decoding="async">
              <span class="box__badge">Recheados premium</span>
            </div>
            <div class="box__body">
              <h3 class="box__name">Hello Box Premium</h3>
