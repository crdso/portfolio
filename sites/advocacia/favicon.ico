<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Advogado criminalista em crimes sexuais | Guilherme Podgaietsky</title>
<meta name="description" content="Defesa criminal técnica, estratégica e sigilosa em crimes sexuais. Atendimento em Rio do Sul e online em todo o Brasil."><meta name="theme-color" content="#0b0d11">
<link rel="icon" type="image/jpeg" href="img/logo-oficial.jpg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0d11;--bg2:#11141a;--surface:#181c24;--paper:#f6f3ec;--white:#fff;--ink:#171719;--muted:#aaa8a3;--gold:#caa85f;--gold2:#e2c57f;--line:rgba(202,168,95,.28);--r:18px;--max:1140px;--ease:cubic-bezier(.2,.7,.2,1)}
*,*::before,*::after{box-sizing:border-box}html,body{width:100%;max-width:100%;overflow-x:clip}html{scroll-behavior:smooth;scroll-padding-top:112px;background:var(--bg)}body{margin:0;padding-bottom:80px;background:var(--bg);color:var(--paper);font:17px/1.7 Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}img,video,iframe,svg{max-width:100%}img,video{height:auto}main,section,header,footer,nav,div,article,figure,form{min-width:0}a{color:inherit}button,input,textarea{font:inherit}p{max-width:65ch}.container{width:min(calc(100% - 32px),var(--max));margin-inline:auto}.section{padding:68px 0;position:relative}.dark{background:var(--bg)}.dark2{background:var(--bg2)}.light{background:var(--paper);color:var(--ink)}
.kicker{margin:0 0 10px;color:var(--gold);font:700 .72rem/1.3 Montserrat;letter-spacing:.15em;text-transform:uppercase}.title{margin:0;font:600 clamp(1.85rem,4vw,2.7rem)/1.12 Montserrat;letter-spacing:-.035em;text-wrap:balance}.title::after{content:"";display:block;width:44px;height:2px;margin-top:18px;background:var(--gold)}.lead{margin:22px 0 0;color:#5f5d58;font-size:1rem}.dark .lead,.dark2 .lead{color:#c6c4bd}.icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}.skip{position:fixed;left:12px;top:-100px;z-index:9999;background:var(--paper);color:var(--ink);padding:12px}.skip:focus{top:12px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:0 19px;border:1px solid transparent;border-radius:12px;font:700 .8rem/1 Montserrat;text-decoration:none;text-align:center;cursor:pointer;transition:.25s var(--ease)}.btn::after{content:"→";transition:transform .25s}.btn:hover{transform:translateY(-2px)}.btn:hover::after{transform:translateX(4px)}.primary{background:var(--gold);border-color:var(--gold);color:var(--bg);box-shadow:0 12px 30px rgba(202,168,95,.16)}.primary:hover{background:var(--gold2);border-color:var(--gold2)}.outline{border-color:rgba(226,197,127,.52);color:var(--paper);background:transparent}.darkbtn{background:var(--bg);border-color:var(--bg);color:#fff!important;opacity:1!important}.btn:focus-visible,a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--gold2);outline-offset:3px}
.urgent{position:relative;z-index:902;min-height:38px;background:#080a0d;border-bottom:1px solid var(--line);display:flex;align-items:center}.urgent .container{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-block:5px;font:600 .63rem/1.35 Montserrat;letter-spacing:.07em;text-transform:uppercase}.urgent a{color:var(--gold2);text-decoration:none;white-space:nowrap}.header{position:sticky;top:0;z-index:900;background:rgba(11,13,17,.94);border-bottom:1px solid rgba(202,168,95,.16);backdrop-filter:blur(16px);transition:transform .35s var(--ease)}.header.hide{transform:translateY(-105%)}.nav{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;min-width:0}.brandmark{width:44px;height:44px;object-fit:contain;flex:0 0 auto;mix-blend-mode:screen}.brandcopy strong{display:block;color:var(--paper);font:700 .72rem/1.2 Montserrat;letter-spacing:.105em;text-transform:uppercase}.brandcopy small{display:block;margin-top:3px;color:#aaa;font-size:.55rem;letter-spacing:.06em}.navlinks{display:none}.navlinks a{min-height:48px;display:flex;align-items:center;text-decoration:none;font-size:.8rem}.menu{width:48px;height:48px;border:0;background:transparent;color:#fff;display:grid;place-items:center}.menu span,.menu span::before,.menu span::after{content:"";display:block;width:24px;height:2px;background:currentColor;position:relative}.menu span::before{position:absolute;top:-7px}.menu span::after{position:absolute;top:7px}.nav.open .navlinks{display:flex;position:absolute;left:0;right:0;top:70px;padding:16px 20px 24px;background:#0b0d11;flex-direction:column;border-bottom:1px solid var(--line)}.headcta{display:none}
.hero{position:relative;isolation:isolate;display:grid;align-items:center;min-height:calc(100svh - 108px);overflow:hidden}.herovideo{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% center;filter:saturate(.62) contrast(1.08);animation:drift 15s ease-in-out alternate infinite}.shade{position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgba(11,13,17,.98),rgba(11,13,17,.72)),linear-gradient(0deg,rgba(11,13,17,.96),transparent 65%)}.heroin{min-height:inherit;display:flex;align-items:center;padding-block:82px 116px}.herocopy{max-width:760px}.herokicker{display:flex;align-items:center;gap:10px;margin:0 0 22px;color:var(--gold2);font:700 .7rem/1.2 Montserrat;letter-spacing:.15em;text-transform:uppercase}.herokicker::before{content:"";width:34px;height:1px;background:currentColor}.hero h1{margin:0;color:var(--paper);font:700 clamp(2.55rem,12vw,4.1rem)/1.02 Montserrat;letter-spacing:-.055em;text-wrap:balance}.hero h1 span{display:block}.accent{color:var(--gold2)}.herosub{margin:24px 0 0;color:#d4d1ca;font-size:1rem}.heroactions{display:grid;gap:10px;margin-top:28px}.insta{background:rgba(11,13,17,.68);border-color:rgba(226,197,127,.54);color:#fff;backdrop-filter:blur(10px)}.trust{display:flex;flex-wrap:wrap;gap:8px 18px;margin:24px 0 0;padding:0;list-style:none;color:#bbb8b0;font-size:.78rem}.trust li{display:flex;align-items:center;gap:8px}.trust li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--gold)}.scrollcue{position:absolute;bottom:24px;left:50%;display:flex;align-items:center;gap:9px;color:#aaa;font:600 .64rem Montserrat;letter-spacing:.11em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transform:translateX(-50%)}.scrollcue::before{content:"";width:30px;height:1px;background:var(--gold)}.enter{opacity:0;transform:translateY(16px);animation:enter .7s var(--ease) forwards;animation-delay:var(--d)}@keyframes enter{to{opacity:1;transform:none}}@keyframes drift{to{transform:scale(1.035)}}
.marqueewrap{width:100%;overflow:hidden;background:#080a0d;border-block:1px solid var(--line)}.marquee{display:flex;width:max-content;padding:13px 0;animation:marquee 44s linear infinite}.marqueeset{display:flex;white-space:nowrap}.marquee span{color:#d7d3ca;font:600 .68rem Montserrat;letter-spacing:.11em;margin-right:28px}.marquee span::after{content:"◆";color:var(--gold);font-size:.5rem;margin-left:28px}@keyframes marquee{to{transform:translateX(-50%)}}
.proof{background:var(--bg2);border-bottom:1px solid var(--line)}.proofgrid{display:grid;grid-template-columns:1fr 1fr}.proofitem{padding:22px 10px;text-align:center;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.proofitem:nth-child(even){border-right:0}.proofitem strong{display:block;color:var(--gold2);font:700 1.28rem/1.15 Montserrat}.proofitem span{color:#aaa;font-size:.7rem}
.grid{display:grid;gap:14px;margin-top:34px}.card{border-radius:var(--r);transition:.28s var(--ease)}.situation{padding:24px;background:#fff;border:1px solid rgba(23,23,25,.11);box-shadow:0 14px 34px rgba(23,23,25,.06)}.situation:hover{transform:translateY(-4px);border-color:var(--gold)}.situation .icon{width:27px;height:27px;color:#967435}.situation h3{margin:14px 0 8px;font:700 1rem/1.35 Montserrat}.situation p{margin:0;color:#625f59;font-size:.9rem}.action{display:inline-flex;align-items:center;justify-content:center;min-height:42px;margin-top:18px;padding:0 14px;border:1px solid var(--gold);border-radius:10px;background:var(--gold);color:var(--bg);font:700 .72rem/1.2 Montserrat;text-decoration:none}.action:hover{background:var(--gold2);transform:translateY(-2px)}
.steps{display:grid;margin-top:36px;counter-reset:step}.step{position:relative;padding:22px 0 22px 68px;border-bottom:1px solid var(--line)}.step::before{counter-increment:step;content:counter(step);position:absolute;left:0;top:21px;width:46px;height:46px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold2);font:700 .95rem Montserrat}.step h3{margin:0;font:700 1rem Montserrat}.step p{margin:7px 0 0;color:#b9b7b0;font-size:.9rem}.conf{display:flex;align-items:center;gap:10px;margin-top:26px;color:#c5c2ba;font-size:.86rem}.conf .icon{color:var(--gold2)}
.urgency{background:var(--gold);color:var(--bg)}.urgency .container{display:grid;gap:20px;align-items:center;padding-block:30px}.urgency h2{margin:0;font:700 clamp(1.35rem,4vw,2rem)/1.2 Montserrat}.urgency p{margin:6px 0 0;color:#29251e;font-size:.9rem}.urgency .btn{width:100%}
.booking{display:grid;gap:30px;margin-top:34px}.office{margin:0}.office picture{display:block;aspect-ratio:4/3;overflow:hidden;border-radius:var(--r);box-shadow:0 18px 42px rgba(23,23,25,.13)}.office img{display:block;width:100%;height:100%;object-fit:cover;filter:none;transition:transform .6s var(--ease)}.office figcaption{margin-top:8px;color:#6c6860;font-size:.75rem}.bookopts{display:grid;gap:12px;margin-top:20px}.bookopt{display:flex;flex-direction:column;justify-content:center;min-height:82px;padding:17px 18px;border:1px solid rgba(23,23,25,.16);border-radius:13px;background:#fff;color:var(--ink);text-align:left;text-decoration:none;box-shadow:0 9px 24px rgba(23,23,25,.05);cursor:pointer}.bookopt.active{border-color:var(--gold);box-shadow:inset 4px 0 #8d6c32}.bookopt strong{font:700 .92rem Montserrat}.bookopt span{margin-top:4px;color:#66615a;font-size:.76rem}.bookpanel{padding:22px;border:1px solid var(--gold);border-radius:var(--r);background:var(--bg2);color:var(--paper)}.bookpanel h3{margin:0;font:700 1.25rem Montserrat}.tabs{display:flex;gap:8px;margin:18px 0}.tabs button{flex:1;min-height:48px;padding:8px;border:1px solid #4e5360;border-radius:9px;background:var(--surface);color:#fff;font-size:.72rem}.tabs button.active{border-color:var(--gold);color:var(--gold2)}.form{display:grid;gap:12px}.field label{display:block;margin-bottom:5px;font-size:.75rem;font-weight:600}.field input,.field textarea{width:100%;min-height:48px;padding:12px;border:1px solid #4e5360;border-radius:9px;background:var(--surface);color:#fff}.field textarea{min-height:92px;resize:vertical}.field small{font-size:.67rem;color:#aaa}.bookmeta{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:15px 0;color:#c4c1ba;font-size:.72rem}.agendaframe{display:none;margin-top:18px}.agendaframe.show{display:block}.agendaframe iframe{width:100%;min-height:590px;border:0;background:#fff}.fallback{padding:20px;border:1px dashed #686d78;text-align:center}.confirm{display:none;margin-top:15px;padding:17px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.confirm.show{display:block}
.biogrid{display:grid;gap:38px}.biopic{position:relative;width:100%;max-width:420px;aspect-ratio:4/5;margin:auto}.biopic::before{content:"";position:absolute;inset:12px -10px -10px 12px;border:1px solid var(--gold);border-radius:var(--r)}.biopic picture{display:block;position:relative;width:100%;height:100%;overflow:hidden;border-radius:var(--r)}.biopic img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:none;transition:transform .6s}.biocopy p{color:#c3c0b9}.credentials{margin:20px 0;padding:0;list-style:none}.credentials li{position:relative;padding:8px 0 8px 24px;color:#d4d1ca;font-size:.9rem}.credentials li::before{content:"";position:absolute;left:0;top:19px;width:11px;height:2px;background:var(--gold)}
.rail{display:flex;width:100%;gap:14px;margin:0;padding:32px 0 14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.rail::-webkit-scrollbar{display:none}.videocard{flex:0 0 82%;max-width:82%;overflow:hidden;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);scroll-snap-align:center}.stage{position:relative;display:grid;place-items:center;aspect-ratio:9/16;overflow:hidden;background:#252933}.stage video,.poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.stage video{display:none}.stage.playing video{display:block}.stage.playing .poster,.stage.playing .play{display:none}.play{position:relative;z-index:2;width:66px;height:66px;border:1px solid var(--gold2);border-radius:50%;background:rgba(11,13,17,.8);color:var(--gold2);display:grid;place-items:center}.videoinfo{padding:19px}.videoinfo h3{margin:0 0 13px;font:700 .96rem/1.4 Montserrat}.videoerror{min-height:1em;color:var(--gold2);font-size:.72rem}.dots{display:flex;justify-content:center;gap:8px;margin-top:8px}.dot{width:8px;height:8px;padding:0;border:0;border-radius:50%;background:#7f8187}.dot.active{background:var(--gold);transform:scale(1.3)}
.service{flex:0 0 85%;max-width:85%;overflow:hidden;border:1px solid rgba(23,23,25,.12);border-radius:var(--r);background:#fff;color:var(--ink);box-shadow:0 14px 32px rgba(23,23,25,.07);scroll-snap-align:center}.service picture{display:block;aspect-ratio:2.1/1;background:var(--bg)}.service img{display:block;width:100%;height:100%;object-fit:contain;filter:none}.servicebody{padding:19px}.servicebody h3{margin:0;font:700 1rem Montserrat}.servicebody p{margin:8px 0 0;color:#625f59;font-size:.87rem}
.areagrid{grid-template-columns:1fr}.areacard{min-height:142px;padding:20px;border:1px solid var(--line);border-radius:15px;background:var(--surface);color:#fff;text-align:left}.areacard .icon{width:26px;height:26px;color:var(--gold2)}.areacard h3{margin:13px 0 8px;font:700 .98rem/1.35 Montserrat}.areacard span{display:inline-flex;min-height:36px;align-items:center;padding:0 11px;border:1px solid rgba(202,168,95,.5);border-radius:8px;color:var(--gold2);font-size:.68rem}dialog{width:min(calc(100% - 30px),620px);padding:26px;border:1px solid var(--gold);border-radius:var(--r);background:var(--bg2);color:#fff}dialog::backdrop{background:rgba(0,0,0,.82)}.close{position:absolute;right:8px;top:8px;width:48px;height:48px;border:0;background:transparent;color:#fff;font-size:1.6rem}dialog h3{margin:0 42px 13px 0;font:700 1.35rem Montserrat}dialog p{color:#c4c1ba}
.rating{display:grid;gap:28px;align-items:center;padding:25px;border:1px solid rgba(23,23,25,.12);border-radius:20px;background:#fff;box-shadow:0 18px 42px rgba(23,23,25,.07)}.score{display:grid;gap:4px;justify-items:start}.score strong{color:#7b5d29;font:700 4.2rem/1 Montserrat;letter-spacing:-.06em}.stars{color:#a77f35;font-size:1.2rem;letter-spacing:.11em}.score span{color:#625f59;font-size:.84rem}.rating .btn{width:100%}
.guidegrid{display:grid;gap:28px}.guideart{min-height:290px;padding:30px;border:1px solid rgba(226,197,127,.48);border-radius:var(--r);background:linear-gradient(145deg,#202632,var(--bg));box-shadow:14px 14px 0 rgba(202,168,95,.1);display:grid;place-items:center start}.guidelabel{display:block;margin-bottom:10px;color:var(--gold2);font:700 .72rem Montserrat;letter-spacing:.13em}.guideart strong{display:block;font:600 clamp(1.65rem,5vw,2.5rem)/1.12 Montserrat}.guideform{padding-left:20px;border-left:2px solid var(--gold)}.guideform input{width:100%;min-height:50px;margin:5px 0 11px;padding:12px;border:1px solid #555b67;border-radius:9px;background:var(--surface);color:#fff}.guideform small{display:block;margin-bottom:14px;color:#aaa}.guidesuccess{display:none}.guidesuccess.show{display:block}
.faqlist{display:grid;gap:10px;margin-top:32px}.faqitem{overflow:hidden;border:1px solid rgba(23,23,25,.13);border-radius:13px;background:#fff}.faqq{width:100%;min-height:68px;padding:16px 18px;border:0;background:transparent;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:16px;text-align:left;font:600 .91rem/1.4 Montserrat}.faqq span:last-child{color:#8c6b31;font:400 1.6rem Arial;transition:transform .3s}.faqq[aria-expanded=true] span:last-child{transform:rotate(45deg)}.faqa{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s}.faqa>div{overflow:hidden}.faqa p{margin:0;padding:0 18px 18px;color:#605d57;font-size:.9rem}.faqq[aria-expanded=true]+.faqa{grid-template-rows:1fr}
.articlegrid{grid-template-columns:1fr}.article{min-height:230px;padding:24px;border:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column}.article time{color:var(--gold2);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}.article h3{margin:12px 0 8px;font:700 1.1rem/1.35 Montserrat}.article p{margin:0;color:#bcb9b2;font-size:.88rem}.article .action{margin-top:auto;align-self:flex-start}
.final{background:radial-gradient(circle at 90% 10%,rgba(202,168,95,.12),transparent 34%),var(--bg)}.finalgrid{display:grid;gap:34px}.contacts{margin:24px 0;padding:0;list-style:none}.contacts li{display:flex;gap:11px;margin:13px 0;color:#cfccc5;font-size:.9rem}.contacts .icon{color:var(--gold2)}.contacts a{text-decoration:none}.contacts a,.contacts span{overflow-wrap:anywhere}.map{min-height:360px;overflow:hidden;border:1px solid var(--line);border-radius:var(--r)}.map iframe{display:block;width:100%;height:100%;min-height:360px;border:0;filter:none!important}
footer{padding:38px 0 102px;border-top:1px solid var(--line);background:#07090c;color:#aaa}.footergrid{display:grid;gap:24px}.social a{min-height:44px;display:inline-flex;align-items:center;padding:0 13px;border:1px solid var(--line);border-radius:9px;color:#fff;font-size:.78rem;text-decoration:none}.legal{font-size:.72rem;color:#898b91}.floatbar{position:fixed;z-index:950;left:0;right:0;bottom:0;width:100%;display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:7px;padding:8px 10px calc(8px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:rgba(11,13,17,.97);backdrop-filter:blur(14px)}.float{height:48px;min-width:0;display:flex;align-items:center;justify-content:center;gap:6px;padding:0 8px;border:1px solid #454a55;border-radius:9px;background:var(--surface);color:#fff;font:700 13px Montserrat;text-decoration:none;white-space:nowrap;overflow:hidden}.floatwa{background:var(--gold);border-color:var(--gold);color:var(--bg)}body.keyboard .floatbar{display:none}
[data-reveal]{opacity:0;transform:translateY(16px);transition:opacity .65s var(--ease),transform .65s var(--ease)}[data-reveal].shown{opacity:1;transform:none}
@media(min-width:720px){body{padding-bottom:0}.section{padding:92px 0}.heroactions{display:flex}.urgency .container{grid-template-columns:1fr auto}.urgency .btn{width:auto}.situations,.articlegrid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(2,1fr);gap:0 28px}.bookopts{grid-template-columns:1fr 1fr}.biogrid,.guidegrid,.finalgrid{grid-template-columns:1fr 1.15fr;align-items:center}.videocard,.service{flex-basis:47%;max-width:47%}.areagrid{grid-template-columns:repeat(2,1fr)}.rating{grid-template-columns:1.3fr .5fr auto;padding:38px}.rating .btn{width:auto}.footergrid{grid-template-columns:1fr 1fr}.floatbar{left:auto;right:18px;bottom:18px;width:auto;display:flex;padding:0;background:transparent;border:0}.float{padding:0 16px}.floatcall,.floatbook{display:none}footer{padding-bottom:38px}}
@media(min-width:980px){.container{width:min(calc(100% - 64px),var(--max))}.menu{display:none}.navlinks{display:flex;align-items:center;gap:24px;margin-left:auto}.headcta{display:inline-flex}.herovideo{object-position:center}.shade{background:linear-gradient(90deg,rgba(11,13,17,.98) 0%,rgba(11,13,17,.86) 42%,rgba(11,13,17,.2) 80%)}.heroin{padding-block:110px 130px}.hero h1{font-size:clamp(3.7rem,6vw,5.4rem)}.proofgrid{grid-template-columns:repeat(4,1fr)}.proofitem{border-bottom:0}.proofitem:nth-child(even){border-right:1px solid var(--line)}.proofitem:last-child{border-right:0}.situations{grid-template-columns:repeat(4,1fr)}.steps{grid-template-columns:repeat(4,1fr);gap:0}.step{padding:72px 18px 12px;border-right:1px solid var(--line);border-bottom:0}.step::before{left:18px;top:5px}.booking{grid-template-columns:.9fr 1.1fr;align-items:start}.bookpanel{padding:28px}.office:hover img,.biopic:hover img{transform:scale(1.03)}.biogrid{grid-template-columns:.78fr 1.22fr;gap:78px}.rail[data-carousel=videos]{overflow:visible;align-items:center}.videocard{flex:1;max-width:none}.videocard.featured{flex:1.12}.rail[data-carousel=services]{display:grid;grid-template-columns:repeat(3,1fr);overflow:visible;gap:18px}.service{max-width:none}.areagrid{grid-template-columns:repeat(3,1fr)}.articlegrid{grid-template-columns:repeat(3,1fr)}.footergrid{grid-template-columns:1fr .7fr 1.3fr}.dots{display:none}}
@media(max-width:430px){.urgent .container{width:calc(100% - 24px);font-size:.56rem}.urgent span{max-width:64%}.brandcopy strong{font-size:.64rem}.brandcopy small{font-size:.48rem}.brandmark{width:38px;height:43px}.hero h1{font-size:clamp(2.45rem,11.5vw,3.25rem)}.herosub{font-size:.95rem}.score strong{font-size:3.9rem}}
